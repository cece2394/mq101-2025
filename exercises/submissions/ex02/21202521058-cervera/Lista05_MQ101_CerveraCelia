# EXERCICIO 7 – Diagnóstico simples do modelo

dados_diag <- augment(mod1)
glimpse(dados_diag)

# Construa:
# um gráfico de resíduos vs valores ajustados (.resid vs .fitted)

ggplot(dados_diag, aes(x = .fitted, y = .resid)) +
  geom_point(alpha = 0.4, color = "#2C7FB8") +
  geom_hline(yintercept = 0, linetype = "dashed")+ 
  geom_smooth(method = "loess", se = FALSE, color = "#D95F02") +
  labs(
    title = "Resíduos vs. Valores Ajustados",
    x = "Valores ajustados (.fitted)",
    y = "Resíduos (.resid)"
  ) +
  theme_minimal()

# O gráfico de resíduos vs. valores ajustados mostra evidências claras de heterocedasticidade.
# Para valores ajustados mais baixos (à esquerda), os resíduos estão muito
# espalhados. Para valores ajustados altos (à direita), os resíduos ficam mais estreitos, 
# com variância menor (padrão em funil). Os resíduos não estão distribuídos de forma 
# aleatória ao redor de zero.


# um gráfico QQ-plot dos resíduos.

ggplot(dados_diag, aes(sample = .resid)) +
  stat_qq() +
  stat_qq_line()

# A distribuição dos resíduos é aproximadamente normal.
# Os pontos seguem muito de perto a linha teórica, com apenas desvios leves nas caudas.

