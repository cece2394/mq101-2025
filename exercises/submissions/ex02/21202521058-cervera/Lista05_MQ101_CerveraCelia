# EXERCICIO 3 - Test Qui-quadrado

tab_sexo_apoio <- table(dados$sexo, dados$apoio_gov)
tab_sexo_apoio

prop.table(tab_sexo_apoio, margin = 2)

# H0: não há associação entre sexo e apoio_gov na população;
# H1: há associação entre sexo e apoio_gov.

# Test Qui-quadrado

chisq.test(tab_sexo_apoio)

#O valor do qui-quadrado é 0,68956. O grau de liberdade é 1. 
#O valor do p-value = 0.4063, por tanto o valor não é significativo.
#Não se rejeita Ho, então aceitamos que não há evidência estatisticamente
#significativa de que o apoio ao governo depende do sexo.


ggplot(dados, aes(x = sexo, fill = factor(apoio_gov))) +
  geom_bar(position = "fill") +
  scale_y_continuous(labels = scales::percent) +
  labs(fill = "Apoio ao governo")

# O padrão visual é coerente com o resultado do teste, pois em ambas as categorias 
# há uma porcentagem semelhante de pessoas que não aprovam o governo.

